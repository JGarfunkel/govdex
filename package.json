{
  "name": "civic-dashboards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Civic Dashboards — powered by Ordinizer",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_execpath||'')){console.error('\\nThis repo is a pnpm workspace (apps/, packages/, ingestion/). Plain npm install does not understand pnpm-workspace.yaml and will wipe the @govdex/* workspace symlinks. Run: pnpm install\\n');process.exit(1)}\"",
    "dev": "cross-env NODE_ENV=development npx tsx server/index.ts",
    "build-local": "npx vite build && npx next build reports/ny-transparency && pnpm -C apps/web exec next build && esbuild server/index.ts --platform=node --bundle --packages=bundle --external:vite --external:next --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "build": "npx vite build && npx next build reports/ny-transparency && pnpm -C apps/web exec next build && esbuild server/index.ts --platform=node --bundle --packages=bundle --external:vite --external:next --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "start": "cross-env NODE_ENV=production node --env-file=prod.env dist/index.cjs",
    "check": "tsc",
    "test": "vitest run",
    "ny-transparency:export-scoped-csv": "npx tsx reports/ny-transparency/scripts/export-scoped-csv.ts",
    "load-local": "pnpm add ../ordinizer/app/client ../ordinizer/app/server ../ordinizer/app/analyzer",
    "load-latest": "pnpm add @civillyengaged/ordinizer-client@latest @civillyengaged/ordinizer-server@latest @civillyengaged/ordinizer-analyzer@latest",
    "govdex:db:up": "docker compose -f infra/docker-compose.yml up -d",
    "govdex:db:down": "docker compose -f infra/docker-compose.yml down",
    "govdex:db:schema": "docker compose -f infra/docker-compose.yml exec -T db psql -U atlas_civic -d atlas_civic -f /schema/schema.sql",
    "govdex:db:migrate": "npx tsx packages/db/src/migrate.ts",
    "govdex:db:migrate:baseline": "npx tsx packages/db/src/migrate.ts --baseline",
    "govdex:seed:concepts": "docker compose -f infra/docker-compose.yml exec -T db psql -U atlas_civic -d atlas_civic -f /schema/seed/concepts.sql",
    "govdex:seed:categories": "docker compose -f infra/docker-compose.yml exec -T db psql -U atlas_civic -d atlas_civic -f /schema/seed/body_categories.sql",
    "govdex:seed:functions": "docker compose -f infra/docker-compose.yml exec -T db psql -U atlas_civic -d atlas_civic -f /schema/seed/product_functions.sql",
    "govdex:seed:us-ny": "npx tsx ingestion/tools/seed-profile.ts ny",
    "govdex:seed": "npm run govdex:seed:concepts && npm run govdex:seed:categories && npm run govdex:seed:functions && npm run govdex:seed:us-ny",
    "govdex:t00:check": "npx tsx ingestion/t00-lookups/run.ts",
    "govdex:t01": "npx tsx ingestion/t01-jurisdictions/run.ts",
    "govdex:t01b": "npx tsx ingestion/t01b-school-districts/run.ts",
    "govdex:t01c": "npx tsx ingestion/t01c-boces/run.ts",
    "govdex:t02": "npx tsx ingestion/t02-relations/run.ts",
    "govdex:load-state": "npx tsx ingestion/load-state/run.ts",
    "govdex:t01d:nyc": "npx tsx ingestion/t01d-nyc/run.ts",
    "govdex:t04": "npx tsx ingestion/t04-bodies/run.ts",
    "govdex:t06:slugs": "npx tsx ingestion/t06-slugs/run.ts",
    "govdex:t05": "npx tsx ingestion/t05-officials/run.ts",
    "govdex:spider": "npx tsx ingestion/spider/run.ts",
    "govdex:spider:smoke": "npx tsx ingestion/spider/run.ts --smoke",
    "govdex:crawl-worker": "npx tsx ingestion/spider/worker.ts",
    "govdex:inspect": "npx tsx ingestion/tools/inspect-jurisdiction.ts",
    "govdex:seed-website": "npx tsx ingestion/tools/seed-website.ts",
    "govdex:scan-vendors": "npx tsx ingestion/tools/scan-vendors.ts",
    "govdex:page-cache:backfill": "npx tsx ingestion/tools/backfill-page-cache-to-r2.ts",
    "govdex:candidate-cache:backfill": "npx tsx ingestion/tools/backfill-candidate-page-cache.ts",
    "govdex:cache:whois": "npx tsx ingestion/tools/whois-cached-page.ts",
    "govdex:add-body": "npx tsx ingestion/tools/add-body.ts",
    "govdex:probe-apis": "npx tsx ingestion/tools/probe-civic-apis.ts",
    "govdex:prune-candidates": "npx tsx ingestion/tools/prune-dead-candidates.ts"
  },
  "dependencies": {
    "@civillyengaged/ordinizer-analyzer": "^1.0.7",
    "@civillyengaged/ordinizer-client": "^1.0.13",
    "@civillyengaged/ordinizer-core": "^1.0.7",
    "@civillyengaged/ordinizer-server": "^1.0.11",
    "@pinecone-database/pinecone": "^6.1.2",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@vitejs/plugin-react": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-pg-simple": "^10.0.0",
    "cross-env": "^10.1.0",
    "csv-parse": "^5.6.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "fs-extra": "^11.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "memorystore": "^1.6.7",
    "nanoid": "^5.1.5",
    "next": "^16.3.5",
    "openai": "^6.35.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "vite": "^5.4.19",
    "wouter": "^3.9.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
